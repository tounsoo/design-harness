{
  "params": {
    "items": { "type": "list", "of": "text", "description": "What the room has, one line each.", "example": ["Screen", "Whiteboard"] },
    "summary": { "type": "text", "default": "Room details", "description": "The disclosure's summary: the disclosed section's name." }
  },
  "root": "details",
  "elements": {
    "details": { "type": "Disclosure.Root", "props": {}, "children": ["summary", "items"] },
    "summary": { "type": "Disclosure.Summary", "props": { "text": { "$param": "summary" } }, "children": [] },
    "items": { "type": "Stack.Root", "props": { "gap": "condensed" }, "repeat": { "param": "items" }, "children": ["item"] },
    "item": { "type": "Text.Root", "props": { "as": "p", "text": { "$item": "" } }, "children": [] }
  }
}
