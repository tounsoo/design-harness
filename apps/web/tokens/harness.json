{
  "harness": {
    "$description": "design-harness's own tokens, read by the app's layout CSS.",
    "canvas": {
      "dot-gap": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "padding": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/space/8/$value"
        }
      },
      "row-gap": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/space/10/$value"
        }
      },
      "frame-gap": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/space/8/$value"
        }
      }
    },
    "artboard": {
      "radius": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/radius/md/$value"
        }
      },
      "label-gap": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/space/2/$value"
        }
      },
      "selected": {
        "$type": "color",
        "$value": {
          "$ref": "#/color/status/critical/border/$value"
        }
      }
    },
    "floating": {
      "radius": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/radius/lg/$value"
        }
      },
      "bg": {
        "$type": "color",
        "$value": {
          "$ref": "#/color/bg/elevated/$value"
        }
      }
    },
    "panel": {
      "bg": {
        "$type": "color",
        "$value": {
          "$ref": "#/color/bg/surface/$value"
        }
      },
      "padding": {
        "$type": "dimension",
        "$value": {
          "$ref": "#/space/4/$value"
        }
      },
      "header-height": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      }
    },
    "edge": {
      "$description": "Edges that mark a row's tone, and the rule beside a quoted message.",
      "status": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "px"
        }
      },
      "quote": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    },
    "measure": {
      "$description": "How wide a page of reading grows before it stops: a page, a proposal's review, the variants side by side, a note.",
      "page": {
        "$type": "dimension",
        "$value": {
          "value": 64,
          "unit": "rem"
        }
      },
      "review": {
        "$type": "dimension",
        "$value": {
          "value": 96,
          "unit": "rem"
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": {
          "value": 120,
          "unit": "rem"
        }
      },
      "note": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "rem"
        }
      }
    },
    "size": {
      "$description": "The few fixed sizes the layout needs: the least width of a picker, a column and a label, the most a name or a log may take, the code editor's least height, the room a sticky bar keeps clear, and the New project wizard's rail, its reading column, its wide steps, its role cards and its option columns.",
      "picker": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "rem"
        }
      },
      "picker-wide": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "rem"
        }
      },
      "zoom": {
        "$type": "dimension",
        "$value": {
          "value": 7.5,
          "unit": "rem"
        }
      },
      "column": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "rem"
        }
      },
      "views-row": {
        "$description": "The least width of a card that shows every view of a page side by side.",
        "$type": "dimension",
        "$value": {
          "value": 34,
          "unit": "rem"
        }
      },
      "label": {
        "$type": "dimension",
        "$value": {
          "value": 6,
          "unit": "rem"
        }
      },
      "name": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "rem"
        }
      },
      "log": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "rem"
        }
      },
      "editor": {
        "$type": "dimension",
        "$value": {
          "value": 30,
          "unit": "rem"
        }
      },
      "sticky-clearance": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "rem"
        }
      },
      "artboard-label": {
        "$type": "dimension",
        "$value": {
          "value": 10.5,
          "unit": "rem"
        }
      },
      "wizard-rail": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "rem"
        }
      },
      "wizard-step": {
        "$type": "dimension",
        "$value": {
          "value": 42,
          "unit": "rem"
        }
      },
      "wizard-wide": {
        "$type": "dimension",
        "$value": {
          "value": 76,
          "unit": "rem"
        }
      },
      "role-card": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "rem"
        }
      },
      "option": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "rem"
        }
      }
    },
    "annotation": {
      "$description": "Ink for what the app draws over an artboard: guides, hit areas and marks. An artboard is the prototype's page in its view's own scheme, whatever the app's theme, so each colour is fixed for a light page and for a dark page and does not follow the app's appearance.",
      "on-light": {
        "ink": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/gray/800/$value"
          }
        },
        "fail": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/red/600/$value"
          }
        },
        "halo": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/gray/0/$value"
          }
        }
      },
      "on-dark": {
        "ink": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/gray/100/$value"
          }
        },
        "fail": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/red/300/$value"
          }
        },
        "halo": {
          "$type": "color",
          "$value": {
            "$ref": "#/color/gray/950/$value"
          }
        }
      },
      "stroke": {
        "$type": "dimension",
        "$value": {
          "value": 1.5,
          "unit": "px"
        }
      },
      "stroke-strong": {
        "$type": "dimension",
        "$value": {
          "value": 2.5,
          "unit": "px"
        }
      },
      "dash": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "hatch": {
        "$description": "A hatch is what marks a failure without colour: stripes this wide, this far apart.",
        "gap": {
          "$type": "dimension",
          "$value": {
            "value": 6,
            "unit": "px"
          }
        },
        "line": {
          "$type": "dimension",
          "$value": {
            "value": 1.5,
            "unit": "px"
          }
        }
      },
      "label": {
        "size": {
          "$type": "dimension",
          "$value": {
            "value": 11,
            "unit": "px"
          }
        },
        "padding": {
          "$type": "dimension",
          "$value": {
            "value": 4,
            "unit": "px"
          }
        }
      }
    },
    "figure": {
      "$description": "A check card's evidence figure: its least height, and the sizes of the swatches, marks and rows drawn in it.",
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 9,
          "unit": "rem"
        }
      },
      "swatch": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "mark": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "indent": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "track": {
        "$type": "dimension",
        "$value": {
          "value": 0.375,
          "unit": "rem"
        }
      },
      "pip": {
        "$type": "dimension",
        "$value": {
          "value": 1.375,
          "unit": "rem"
        }
      },
      "node": {
        "$type": "dimension",
        "$value": {
          "value": 5.5,
          "unit": "rem"
        }
      }
    }
  }
}
