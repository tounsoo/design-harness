{
  "name": "@design-harness/web",
  "version": "0.0.0",
  "private": true,
  "description": "The design-harness web app: a project's prototype rendered as a board of sandboxed frames, with core's checks beside it. Fully client-side.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/build-vendor.mjs",
    "tokens": "node ../../node_modules/@tounsoo/todae/dist/scripts/build-tokens.js build --resolver tokens/resolver.json --css src/theme/todae-theme.css --types src/theme/todae-theme.types.ts --catalog ../../node_modules/.cache/design-harness/tokens.catalog.json",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "e2e": "npm run build && node e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@design-harness/core": "0.0.0",
    "@json-render/core": "0.23.1",
    "@json-render/react": "0.23.1",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tounsoo/todae": "0.11.3",
    "@tounsoo/todae-0.10.1": "npm:@tounsoo/todae@0.10.1",
    "@tounsoo/todae-0.11.2": "npm:@tounsoo/todae@0.11.2",
    "dom-accessibility-api": "0.7.1",
    "fflate": "0.8.3",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.8"
  },
  "designHarness": {
    "libraries": {
      "@tounsoo/todae": {
        "0.11.3": [
          "dist/todae.css"
        ],
        "0.10.1": [
          "dist/todae.css"
        ],
        "0.11.2": [
          "dist/todae.css"
        ]
      },
      "@mantine/core": {
        "9.7.4": [
          "styles.css"
        ]
      }
    }
  }
}
