{
  "name": "design-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bundle:core": "npm run bundle --workspace @design-harness/core",
    "dev": "npm run dev --workspace @design-harness/web",
    "build": "npm run build --workspace @design-harness/web",
    "e2e": "npm run e2e --workspace @design-harness/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "~7.3.8",
    "vitest": "~4.1.12"
  }
}
